# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Produção: ambas devem ser https://odontoia.app (sem barra final).
CRON_SECRET=

# Stripe — R-92
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FUNDADOR_CONSULTORIO_MENSAL=
STRIPE_PRICE_FUNDADOR_CONSULTORIO_ANUAL=
STRIPE_PRICE_FUNDADOR_CLINICA_MENSAL=
STRIPE_PRICE_FUNDADOR_CLINICA_ANUAL=
# Reservadas para a tabela pública futura; não configure até os valores serem aprovados.
STRIPE_PRICE_PUBLICO_CONSULTORIO_MENSAL=
STRIPE_PRICE_PUBLICO_CONSULTORIO_ANUAL=
STRIPE_PRICE_PUBLICO_CLINICA_MENSAL=
STRIPE_PRICE_PUBLICO_CLINICA_ANUAL=
STRIPE_BILLING_ENABLED=false
# Lista permanente de UUIDs (ClinDent e VIP); a clínica QA usa a variável abaixo.
STRIPE_BILLING_EXEMPT_CLINIC_IDS=
# Clínica sintética de QA, separada da lista de isenções existentes.
STRIPE_BILLING_QA_EXEMPT_CLINIC_ID=
# Exige o domínio odontoia.app verificado no Resend.
EMAIL_FROM=Odonto.IA <equipe@odontoia.app>
LANDING_LEADS_TO=equipe@odontoia.app

# E-mail
RESEND_API_KEY=

# IA
GROQ_API_KEY=
GEMINI_API_KEY=

# Upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# WhatsApp Meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_DEFAULT_CLINICA_ID=

# AbacatePay legado (não usado pelo fluxo Stripe R-92)
ABACATE_PAY_API_KEY=
ABACATE_PAY_WEBHOOK_SECRET=
ABACATE_PAY_PRODUCT_SOLO=
ABACATE_PAY_PRODUCT_CLINICA=
ABACATE_PAY_PRODUCT_AGREGADO=
## R-120 — mantenha false até revisão jurídica dos termos e documentos.
LEGAL_ACCEPTS_ENABLED=false
